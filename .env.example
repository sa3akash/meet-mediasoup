# ==============================================================================
# ENTERPRISE GOOGLE MEET CLONE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER RUNTIME & NETWORK
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000,https://meet.yourdomain.com

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL 16 + Drizzle ORM)
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/meet
DATABASE_MAX_CONNECTIONS=20

# ------------------------------------------------------------------------------
# REDIS (Presence, Room State, Distributed Locks, Pub/Sub)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=super-secure-production-jwt-secret-min-32-chars
REFRESH_SECRET=super-secure-production-refresh-secret-min-32-chars
COOKIE_DOMAIN=yourdomain.com

# WebAuthn / Passkeys
RP_NAME="Meet Enterprise"
RP_ID="yourdomain.com"
ORIGIN="https://meet.yourdomain.com"

# OAuth 2.0 Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# MEDIASOUP WebRTC SFU
# ------------------------------------------------------------------------------
MEDIASOUP_LISTEN_IP=0.0.0.0
# Set to your server's public IP address in cloud production
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
RTC_MIN_PORT=40000
RTC_MAX_PORT=49999

# STUN / TURN Server (Coturn)
TURN_URL=turn:meet.yourdomain.com:3478
TURN_USERNAME=meetuser
TURN_CREDENTIAL=meetsecretpass

# ------------------------------------------------------------------------------
# STORAGE (MinIO / AWS S3)
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=miniopassword
S3_BUCKET=meet-recordings
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# EMAIL (SMTP / Nodemailer)
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Meet <noreply@yourdomain.com>"

# ------------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry & Prometheus)
# ------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=meet-server
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# FRONTEND (Next.js Client)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
